{
  "name": "guardian-drive-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Guardian Drive backend — Express + Socket.io + MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node scripts/dev.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\"",
    "seed": "node scripts/seed.js",
    "models:download": "node scripts/downloadModels.js",
    "export:feedback": "node scripts/exportFeedback.js",
    "make-admin": "node scripts/makeAdmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/services/**/*.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  }
}
