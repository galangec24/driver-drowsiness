PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/guardian_drive
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d
INGEST_API_KEY=simulator_key_change_me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=

# Optional: false-positive verifier (FP_VERIFIER=off disables; threshold override)
FP_VERIFIER=on
FP_VERIFIER_THRESHOLD=

CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# E-mail verification (6-digit code at registration). Free: Brevo, 300 e-mails/day, HTTPS API
# (works on Render's free plan, which blocks SMTP). Leave EMAIL_PROVIDER empty to disable;
# EMAIL_PROVIDER=console prints the code in the server log (local testing).
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Guardian Drive
EMAIL_VERIFICATION=
