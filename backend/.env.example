PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/guardian_drive
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d
INGEST_API_KEY=simulator_key_change_me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=

# Optional: false-positive verifier (FP_VERIFIER=off disables; threshold override)
FP_VERIFIER=on
FP_VERIFIER_THRESHOLD=

CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# E-mail verification (6-digit code at registration). Free: Brevo, 300 e-mails/day, HTTPS API
# (works on Render's free plan, which blocks SMTP). Leave EMAIL_PROVIDER empty to disable;
# EMAIL_PROVIDER=console prints the code in the server log (local testing).
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Guardian Drive
EMAIL_VERIFICATION=
# Never send more than this many e-mails a day (Brevo free plan allows 300).
EMAIL_DAILY_LIMIT=250

# "Continue with Google" (docs/GOOGLE_SIGNIN.md): the OAuth *Web* client id. Not a secret.
GOOGLE_CLIENT_ID=
# Per-IP limits on sign-in / code endpoints (on unless RATE_LIMIT=off).
RATE_LIMIT=

# Many calls at once (docs: Performance and concurrency). Defaults suit one Render instance.
# Database connections (up to; 2 are kept warm).
MONGO_POOL_SIZE=50
# How long ingest keeps a driver in memory (ms); changes drop it at once. 0 = off.
DRIVER_CACHE_MS=30000
# Face recognition: analyses at once, and how many may wait before callers get 503 + Retry-After.
FACE_CONCURRENCY=1
FACE_QUEUE_MAX=8

# Text messages to parents when a driver is drowsy (docs/SMS.md). Leave SMS_PROVIDER empty to
# disable; SMS_PROVIDER=console prints the text in the server log (local testing).
SMS_PROVIDER=
# Semaphore (Philippines, semaphore.co): API key, and an approved sender name (optional).
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
# Twilio (any country), if SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Cost guards: texts per parent per day, and in total per day.
SMS_PER_PARENT_DAILY=10
SMS_DAILY_LIMIT=100
