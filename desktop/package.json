{
  "name": "guardian-drive-desktop",
  "productName": "Guardian Drive",
  "version": "1.0.3",
  "description": "Guardian Drive for Windows: the parent dashboard in its own window.",
  "author": "Emmanuel Christian",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "app.guardiandrive.desktop",
    "productName": "Guardian Drive",
    "files": ["main.js", "package.json"],
    "directories": { "buildResources": "build", "output": "release" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Guardian Drive",
      "artifactName": "GuardianDrive-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
