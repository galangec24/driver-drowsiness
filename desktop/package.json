{
  "name": "guardian-drive-desktop",
  "productName": "Guardian Drive",
  "version": "1.0.8",
  "description": "Guardian Drive for Windows: the parent dashboard in its own window.",
  "author": "Emmanuel Christian",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "app.guardiandrive.desktop",
    "productName": "Guardian Drive",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Guardian Drive",
      "artifactName": "GuardianDrive-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "galangec24",
        "repo": "guardian-drive-download",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
