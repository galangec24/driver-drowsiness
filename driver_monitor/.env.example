API_URL=http://localhost:3000
INGEST_API_KEY=simulator_key_change_me
# Automatic driver recognition: the parent's Guardian Drive account e-mail. Whoever sits down is
# recognised from the face photos taken when each driver was registered in the app.
FAMILY_EMAIL=
# Optional: a fixed driver id instead (one-driver car / testing); disables recognition.
DRIVER_ID=
CAMERA_INDEX=0
POST_INTERVAL_MS=1000
LOG_LEVEL=INFO
# Eye-state image model: shadow (show only) | on (decides PERCLOS) | off
EYE_STATE=shadow
# Vehicle location for the parent map: auto (Windows location on a laptop) | windows | none
#   | fixed (GPS_FIXED=lat,lng) | nmea (USB GPS on the Pi, pip install pyserial)
GPS_SOURCE=auto
# Spoken guidance for the driver (offline). auto = Windows voice on a laptop; on the Pi the Piper
# AI voice when VOICE_MODEL is set (see docs), else espeak-ng. VOICE=0 turns it off.
VOICE=1
VOICE_ENGINE=auto
VOICE_MODEL=
VOICE_RATE=0
BREAK_REMINDER_MIN=120
# Parent -> car voice calls (needs: pip install aiortc sounddevice "python-socketio[asyncio_client]" aiohttp;
# Raspberry Pi also: sudo apt install libportaudio2). Answered hands-free after CALL_AUTO_ANSWER_S seconds.
CALLS=1
CALL_AUTO_ANSWER_S=3
# Optional: Google Geolocation API key (Wi-Fi positioning, billed per request by Google). Used only
# while the GPS has no fix, every GEOLOCATION_EVERY_S seconds. Restrict the key to the Geolocation API.
GOOGLE_GEOLOCATION_KEY=
GEOLOCATION_EVERY_S=90
GPS_FIXED=
GPS_PORT=
GPS_BAUD=9600
# Upload the camera frame to the parent when an alert fires (0 = never send images)
SEND_SNAPSHOTS=1
# Camera: opencv (USB webcam) | picamera2 (Raspberry Pi camera module, ribbon cable)
CAMERA_BACKEND=opencv
# Bluetooth wrist wearable (docs/WEARABLE.md): off | ble. WEARABLE_NAME matches the watch firmware;
# set WEARABLE_ADDRESS (AA:BB:CC:DD:EE:FF) to pin one device, or clear both to use any standard HR strap.
WEARABLE=off
WEARABLE_NAME=GuardianWatch
WEARABLE_ADDRESS=
# Vibrate the watch when drowsy (0 = parent alerts only)
WATCH_ALERTS=1
# Yawn detection: mouth-open ratio and minimum duration (seconds)
YAWN_MAR=0.5
YAWN_MIN_S=1.5
# Dashboard mmWave radar (contactless heart rate + breathing, docs/WEARABLE.md): off | ble
VITALS=off
VITALS_NAME=GuardianRadar
VITALS_ADDRESS=
# With both radar and watch connected, which heart rate is used first: radar | watch
HR_PRIORITY=radar
# Sound on a HIGH in-car alert (car stereo / speaker paired to the Pi), e.g. paplay /home/pi/alarm.wav
ALARM_CMD=
# Head-nod detection: drop below the driver's usual head angle (degrees) and minimum fall speed (deg/s)
NOD_DEG=15
NOD_SPEED=25
# Use models/settings promoted in the admin training console (0 = keep this device's own)
MODEL_SYNC=1
