# Public, non-secret build config. VITE_* values ship to the browser — never put secrets here.
# Leave empty in development: the app calls http://<host it was opened from>:3000.
# Set it for production builds, e.g. VITE_API_URL=https://guardian-drive-api.onrender.com
VITE_API_URL=
# Optional: Google Maps Embed API key (browser key restricted to your site's referrer).
# Not needed: without it the app uses Google's keyless embed + Maps links.
VITE_GOOGLE_MAPS_EMBED_KEY=
